  "viewer":{
   "jshandler":"webview/handlers/ElementHandler"
  },
  "obj_viewer":{
   "name":"fcn",
   "code":{
    "fcn":"function [IndicatorLeft, IndicatorRight] = fcn(lastAngle, PresentAngle, IndicatorPosition)\n    % Determine the turning direction\n    turning = 0;\n    if PresentAngle> lastAngle \n        turning = 1; % Turning right\n    elseif PresentAngle< lastAngle \n        turning = -1; % Turning left\n    end\n    \n    % Update the indicator position based on the turning direction\n    if IndicatorPosition == 1 && turning == -1\n        IndicatorPosition = 0; % Cancel right indicator when turning left\n    elseif IndicatorPosition == -1 && turning == 1\n        IndicatorPosition = 0; % Cancel left indicator when turning right\n    end\n    \n    % Determine the state of left and right indicators\n    if IndicatorPosition == -1\n        IndicatorLeft = 1; % Left indicator is on\n    else\n        IndicatorLeft = 0;\n    end\n    if IndicatorPosition == 1\n        IndicatorRight = 1; % Right indicator is on\n    else\n        IndicatorRight = 0;\n    end\nend\n"
   },
   "code_sid":"Vehicel_Behavior_Modeling:754:1"
  },
