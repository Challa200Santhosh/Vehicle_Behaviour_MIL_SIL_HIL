  codeblock {
    id			    612
    slsfobj		    87
    code		    "function [IndicatorLeft, IndicatorRight] = fcn(lastAngle, PresentAngle, IndicatorPosition)\n    % Deter"
    "mine the turning direction\n    turning = 0;\n    if PresentAngle> lastAngle \n        turning = 1; % Turning righ"
    "t\n    elseif PresentAngle< lastAngle \n        turning = -1; % Turning left\n    end\n    \n    % Update the indi"
    "cator position based on the turning direction\n    if IndicatorPosition == 1 && turning == -1\n        IndicatorPo"
    "sition = 0; % Cancel right indicator when turning left\n    elseif IndicatorPosition == -1 && turning == 1\n      "
    "  IndicatorPosition = 0; % Cancel left indicator when turning right\n    end\n    \n    % Determine the state of l"
    "eft and right indicators\n    if IndicatorPosition == -1\n        IndicatorLeft = 1; % Left indicator is on\n    e"
    "lse\n        IndicatorLeft = 0;\n    end\n    if IndicatorPosition == 1\n        IndicatorRight = 1; % Right indic"
    "ator is on\n    else\n        IndicatorRight = 0;\n    end\nend\n"
    hyperlink {
      line		      [1 4 6 11 13 18 23]
      sTemplate		      "#refobj364_%d"
    }
    totalNumOfObjs	    [7 4 2 0]
  }
